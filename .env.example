# ==========================================
# Flappy Car 3D - Environment Configuration Template
# Duplicate this file as '.env' for local development.
# In production (Render / Vercel), set these in the dashboard settings.
# ==========================================

# Port the Express HTTP server should listen to (Render assigns this automatically)
PORT=5000

# Environment mode: 'development' or 'production'
NODE_ENV=development

# Allowed CORS origins (use '*' or comma-separated list e.g. https://your-site.vercel.app)
CORS_ORIGIN=*

# Application display name
APP_NAME=Flappy Car 3D

# Enable server access/debug logging (true/false)
ENABLE_LOGGING=true
